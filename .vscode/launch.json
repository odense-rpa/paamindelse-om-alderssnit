{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Process workqueue",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Populate queue",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "args": ["--queue"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}
